# Copier en .env et remplir. Ce fichier ne quitte jamais le PC.

# Supabase — Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role : ecrit les cartes. NE JAMAIS mettre cette cle dans app/
SUPABASE_SERVICE_KEY=eyJ...

# Pexels — https://www.pexels.com/api/ (gratuit, 200 req/h)
PEXELS_API_KEY=

# Moteur LLM : "claude-code" (abonnement, 0 EUR) ou "api" (Haiku 4.5, ~1-2 EUR/mois)
LLM_BACKEND=claude-code

# Uniquement si LLM_BACKEND=api
# ANTHROPIC_API_KEY=sk-ant-...

# Modele utilise par claude -p. La reecriture de cartes est une tache cadree :
# sonnet suffit et consomme bien moins de quota d'abonnement qu'opus (mesure :
# ~0,43 $ estimes par lot sur opus). Commenter cette ligne pour reprendre le
# modele par defaut du compte.
CLAUDE_MODEL=sonnet

# Optionnel : chemin explicite vers l'executable Claude Code si l'auto-detection echoue
# CLAUDE_BIN=C:\Users\alexi\AppData\Roaming\npm\node_modules\@anthropic-ai\claude-code\bin\claude.exe
